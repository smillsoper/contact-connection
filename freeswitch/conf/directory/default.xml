<include>
  <!--
    SIP user directory — dev test extensions only.
    Production agents authenticate via dynamic directory lookup; this file
    provides two static extensions for local development and testing.
  -->
  <domain name="$${domain}">

    <params>
      <param name="dial-string" value="${sofia_contact(${dialed_user}@${dialed_domain})}"/>
    </params>

    <variables>
      <variable name="record_stereo"    value="true"/>
    </variables>

    <groups>
      <group name="default">
        <users>

          <user id="1000">
            <params>
              <param name="password"    value="$${default_password}"/>
            </params>
            <variables>
              <variable name="user_context"                value="default"/>
              <variable name="effective_caller_id_name"    value="Dev Agent 1000"/>
              <variable name="effective_caller_id_number"  value="1000"/>
            </variables>
          </user>

          <user id="1001">
            <params>
              <param name="password"    value="$${default_password}"/>
            </params>
            <variables>
              <variable name="user_context"                value="default"/>
              <variable name="effective_caller_id_name"    value="Dev Agent 1001"/>
              <variable name="effective_caller_id_number"  value="1001"/>
            </variables>
          </user>

        </users>
      </group>
    </groups>
  </domain>
</include>
