<include>
  <!--
    SIP user directory for the local domain ($${domain}). Intentionally holds no users:
    every agent authenticates via the dynamic directory (mod_xml_curl -> the API's
    /api/v1/freeswitch/directory, per-tenant a1-hash). The two static dev extensions that
    used to live here (1000/1001 on a committed default_password) were removed in S167 —
    they were reachable on the published SIP ports under the 127.0.0.1 domain.
  -->
  <domain name="$${domain}">

    <params>
      <param name="dial-string" value="${sofia_contact(${dialed_user}@${dialed_domain})}"/>
    </params>

    <variables>
      <variable name="record_stereo"    value="true"/>
    </variables>

  </domain>
</include>
