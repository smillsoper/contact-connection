<include>
  <!--
    Default dialplan context — applies to calls from registered agent softphones.
    The ContactConnection ESL service issues bridge/originate commands to connect
    agents to queued callers; this dialplan handles direct agent-to-agent calls
    and test extensions only.
  -->
  <context name="default">

    <!-- Agent-to-agent direct call: dial 1xxx to reach another agent extension -->
    <!-- Use sip_to_host (the domain from the INVITE To header) so sofia_contact -->
    <!-- resolves against the tenant domain the agent registered under, not 127.0.0.1 -->
    <extension name="agent-extension">
      <condition field="destination_number" expression="^(1\d{3})$">
        <action application="set"    data="call_timeout=30"/>
        <action application="bridge" data="user/$1@${sip_to_host}"/>
      </condition>
    </extension>

    <!-- Hold music test: dial 9732 to hear the MOH stream -->
    <extension name="moh-test">
      <condition field="destination_number" expression="^9732$">
        <action application="answer"/>
        <action application="playback" data="local_stream://moh"/>
      </condition>
    </extension>

    <!-- Echo test: dial 9196 to hear your own voice (latency/audio quality check) -->
    <extension name="echo-test">
      <condition field="destination_number" expression="^9196$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>

    <!-- DID inbound (dev/test): 10+ digit numbers routed through telephony call flow engine.
         Park WITHOUT answer so ESL can reject pre-answer (busy/unavailable/declined).
         In production, inbound DIDs arrive on the external profile (port 5080) and are
         routed to the separate "inbound" context defined in dialplan/inbound.xml. -->
    <extension name="did-inbound-test">
      <condition field="destination_number" expression="^\+?1?(\d{10})$">
        <action application="park"/>
      </condition>
    </extension>

  </context>
</include>
