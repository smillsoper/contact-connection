<configuration name="modules.conf" description="Modules to load">
  <modules>
    <!-- Loggers — must load first -->
    <load module="mod_console"/>
    <load module="mod_logfile"/>

    <!-- Event Socket Library — primary interface to the .NET ESL service -->
    <load module="mod_event_socket"/>

    <!-- SIP signalling via Sofia-SIP -->
    <load module="mod_sofia"/>

    <!-- Dialplan -->
    <load module="mod_dialplan_xml"/>

    <!-- Dynamic XML config via HTTP — directory lookups go to the ContactConnection API -->
    <load module="mod_xml_curl"/>

    <!-- Core API and applications -->
    <load module="mod_commands"/>
    <load module="mod_dptools"/>

    <!-- Text-to-speech — flite engine backs the "tts://flite|<voice>|<text>" TTS play nodes -->
    <load module="mod_flite"/>

    <!-- Bidirectional WebSocket audio streaming — third-party module (MIT), compiled from
         source in the Dockerfile. Lets a tenant-configured external TTS provider (Azure/
         ElevenLabs/etc.) stream synthesized audio into a live call without writing a file. -->
    <load module="mod_audio_stream"/>

    <!-- Loopback endpoint — lets you test dialplan with originate loopback/+1234/XML/public -->
    <load module="mod_loopback"/>

    <!-- Audio codecs — G.711/G.722 are compiled into the core, not separate modules -->
    <load module="mod_opus"/>

    <!-- Audio sources -->
    <load module="mod_tone_stream"/>
    <load module="mod_sndfile"/>
    <load module="mod_shout"/>
    <load module="mod_native_file"/>
    <load module="mod_local_stream"/>
  </modules>
</configuration>
