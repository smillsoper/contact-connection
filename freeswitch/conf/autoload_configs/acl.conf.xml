<configuration name="acl.conf" description="Network Lists">
  <network-lists>
    <!--
      Permissive ACL for WebRTC ICE candidate filtering.
      Allows all IPv4 candidates from browser softphones on the same LAN or Docker host.
      Referenced by apply-candidate-acl in sip_profiles/internal.xml.
    -->
    <list name="webrtc_candidates" default="allow">
      <node type="allow" cidr="0.0.0.0/0"/>
    </list>

    <!--
      ESL (event socket / admin control channel) inbound ACL.
      Only the Docker bridge network this compose project creates, plus loopback,
      may connect — never the public internet. Docker's port-publish NAT rewrites
      the source of host-originated connections to the bridge gateway address
      (172.19.0.1), not 127.0.0.1, hence the /16 rather than loopback.auto alone.
    -->
    <list name="esl_trusted" default="deny">
      <node type="allow" cidr="127.0.0.1/32"/>
      <node type="allow" cidr="172.19.0.0/16"/>
    </list>
  </network-lists>
</configuration>
