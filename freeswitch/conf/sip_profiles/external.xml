<profile name="external">
  <!--
    External SIP profile — inbound calls arrive here from a SIP trunk provider.
    No agent authentication on this profile; calls route to the "public" dialplan
    context which parks them so the ContactConnection ESL service can take over.

    To add a SIP trunk: add a <gateway> block in the <gateways> section below.
    Each tenant's trunk is a separate gateway. The gateway name is referenced in
    the dialplan or by ESL originate commands for outbound calls.
  -->
  <domains>
    <domain name="all" alias="false" parse="false"/>
  </domains>

  <settings>
    <param name="debug"               value="0"/>
    <param name="sip-trace"           value="no"/>
    <param name="context"             value="public"/>
    <param name="dialplan"            value="XML"/>
    <param name="dtmf-duration"       value="2000"/>
    <param name="codec-prefs"         value="$${global_codec_prefs}"/>
    <param name="rfc2833-pt"          value="101"/>

    <param name="sip-port"            value="$${external_sip_port}"/>
    <param name="sip-ip"              value="$${local_ip_v4}"/>
    <!-- Residential connection has a dynamic public IP — STUN lets FreeSWITCH
         discover it at startup and on re-register, so there is no DNS record
         to keep in sync when the ISP rotates the address. -->
    <param name="ext-sip-ip"          value="stun:stun.telnyx.com"/>
    <param name="sip-server-name"     value="ContactConnection"/>

    <param name="rtp-ip"              value="$${local_ip_v4}"/>
    <param name="ext-rtp-ip"          value="stun:stun.telnyx.com"/>

    <param name="hold-music"          value="$${hold_music}"/>
    <param name="manage-presence"     value="false"/>
    <param name="auth-calls"          value="false"/>
    <param name="inbound-codec-negotiation" value="generous"/>
    <param name="rtp-timer-name"      value="soft"/>
    <param name="watchdog-enabled"    value="false"/>

    <!-- Don't emit RFC 3389 comfort-noise (CNG) packets when we have nothing to
         send — stream real silence RTP instead. This keeps the media stream
         continuous so the far-end jitter buffer stays fed and the path stays
         "awake"; without it, the first syllable of a prompt is eaten while the
         carrier/handset ramps its jitter buffer back up (the classic clipped-
         IVR-greeting defect, worst on mobile with DTX). Pairs with the
         tf_answer / tf_play "lead-in silence" priming in the flow engine. -->
    <param name="suppress-cng"        value="true"/>
    <!-- Adaptive inbound jitter buffer (~60 ms) — smooths trunk network jitter
         for cleaner DTMF detection and recording quality. -->
    <param name="auto-jitterbuffer-msec" value="60"/>
  </settings>

  <gateways>
    <!--
      Telnyx SIP trunk — Credential Connection "contactconnection-freeswitch"
      (Connection ID 3035911411885671529). The password is set as
      $${telnyx_sip_password} in the gitignored vars_local.xml (see
      vars_local.example.xml). Inbound calls arriving on this gateway use the
      "public" dialplan context, which parks them for the ESL service.
    -->
    <gateway name="telnyx">
      <param name="username"           value="userstephen58892"/>
      <param name="password"           value="$${telnyx_sip_password}"/>
      <param name="realm"              value="sip.telnyx.com"/>
      <param name="proxy"              value="sip.telnyx.com"/>
      <param name="from-domain"        value="sip.telnyx.com"/>
      <param name="register"           value="true"/>
      <param name="register-transport" value="udp"/>
      <param name="expire-seconds"     value="120"/>
      <param name="retry-seconds"      value="30"/>
      <!-- SIP OPTIONS keepalive every 25s — holds the router's UDP NAT pinhole
           open so Telnyx's inbound INVITEs keep reaching the registered Contact
           regardless of the home router's NAT timeout. -->
      <param name="ping"               value="25"/>
      <param name="caller-id-in-from"  value="true"/>
      <param name="codec-prefs"        value="$${outbound_codec_prefs}"/>
      <param name="context"            value="public"/>
    </gateway>
  </gateways>
</profile>
