<profile name="internal">
  <!--
    Internal SIP profile — agent softphones (Linphone, Zoiper, Bria, etc.)
    register on port 5060. Authenticated via the directory.
  -->
  <domains>
    <domain name="all" alias="true" parse="false"/>
  </domains>

  <settings>
    <param name="debug"               value="0"/>
    <param name="sip-trace"           value="no"/>
    <param name="context"             value="default"/>
    <param name="dialplan"            value="XML"/>
    <param name="dtmf-duration"       value="2000"/>
    <param name="codec-prefs"         value="$${global_codec_prefs}"/>
    <param name="rfc2833-pt"          value="101"/>

    <param name="sip-port"            value="$${internal_sip_port}"/>
    <param name="sip-ip"              value="$${local_ip_v4}"/>
    <param name="ext-sip-ip"          value="auto-nat"/>
    <param name="sip-server-name"     value="ContactConnection"/>

    <param name="rtp-ip"              value="$${local_ip_v4}"/>
    <param name="ext-rtp-ip"          value="auto-nat"/>

    <param name="hold-music"          value="$${hold_music}"/>
    <param name="record-path"         value="$${recordings_dir}"/>

    <param name="manage-presence"     value="false"/>
    <param name="auth-calls"          value="true"/>
    <param name="auth-all-packets"    value="false"/>
    <param name="nonce-ttl"           value="60"/>
    <param name="inbound-codec-negotiation" value="generous"/>
    <param name="rtp-timer-name"      value="soft"/>
    <param name="local-network-acl"   value="localnet.auto"/>
    <param name="disable-register"    value="false"/>
    <param name="watchdog-enabled"    value="false"/>

    <!-- OPTIONS-ping every registered contact (incl. WebSocket softphones) so an idle
         ws socket stays warm between JsSIP REGISTER refreshes. Without this the socket
         gets reaped mid-session and the agent misses inbound calls during the browser's
         re-registration blip. A contact that fails the ping is dropped promptly, so a
         genuinely dead browser is cleared without waiting out the full register expiry. -->
    <param name="all-reg-options-ping" value="true"/>

    <!-- Plain WebSocket for local dev (no cert required) -->
    <param name="ws-binding"          value=":7080"/>
    <!-- Secure WebSocket for external clients (Cloudflare tunnel terminates public TLS;
         cloudflared connects here with TLS verify disabled, so self-signed cert is fine) -->
    <param name="wss-binding"         value=":7443"/>
    <param name="tls-cert-dir"        value="/etc/freeswitch/tls"/>

    <!-- Accept ICE candidates from private/RFC1918 IPs (browser on same LAN or Docker host) -->
    <!-- Default wan.auto rejects RFC1918 addresses; any_v4.auto accepts all IPv4 candidates -->
    <param name="apply-candidate-acl" value="webrtc_candidates"/>
  </settings>

  <!-- No gateways on the internal profile — agents register inbound -->
  <gateways/>
</profile>
