{
  "manifest_version": 3,
  "name": "ContactConnection Agent",
  "short_name": "ContactConnection",
  "version": "0.2.0",
  "description": "Brings your ContactConnection agent portal forward when a call arrives, and marks your clicks and keys on recorded calls.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ContactConnection Agent",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://contactconnection.io"
}
